# langfuse-deploy/.env.example
#
# 本地自部署 Langfuse v4 (pg + redis + clickhouse) + Cloudflare R2 (对象存储)
#
# 复制成 .env 后填值。Langfuse 启动时会校验 R2 三个变量（用 ? 语法），未填会直接报错退出。

# ============================================================
# 1. PostgreSQL（自部署容器）
# ============================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__              # 用 `openssl rand -base64 24` 生成
POSTGRES_VERSION=17
POSTGRES_DB=postgres

# ============================================================
# 2. Redis（自部署容器）
# ============================================================
REDIS_AUTH=__REDIS_PASSWORD__                        # 用 `openssl rand -base64 24` 生成

# ============================================================
# 3. ClickHouse（自部署容器，必须保留）
# ============================================================
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=__CLICKHOUSE_PASSWORD__          # 同上

# ============================================================
# 4. Cloudflare R2（对象存储，替换 MinIO）
# ============================================================
# 在 Cloudflare 控制台 R2 → Create bucket（建议建 1 个桶 + 3 个 prefix）：
#   langfuse 桶内 prefix: events/  media/  exports/
# 或者建 3 个桶：langfuse-events / langfuse-media / langfuse-exports
#
# 然后 R2 → Manage R2 API Tokens → Create API Token：
#   - Permissions: Object Read & Write
#   - TTL: Forever（或自定义）
#   - Bucket: 上面建的桶（All buckets 也行）
# 拿到 3 个值：
R2_ACCOUNT_ID=__R2_ACCOUNT_ID__                      # R2 概览页右下角 32 位 ID
R2_ACCESS_KEY_ID=__R2_ACCESS_KEY_ID__
R2_SECRET_ACCESS_KEY=__R2_SECRET_ACCESS_KEY__

# ============================================================
# 5. Langfuse 自身的 secrets（必须改）
# ============================================================
# 用 `openssl rand -hex 32` 生成两个不同值
SALT=__SALT_HEX32__
ENCRYPTION_KEY=__ENCRYPTION_KEY_HEX32__              # 64 字符 hex

NEXTAUTH_SECRET=__NEXTAUTH_SECRET__                   # 任意字符串
NEXTAUTH_URL=http://localhost:3000

# ============================================================
# 6. 可选：Langfuse init（首次启动自动建组织 + project + user）
# ============================================================
# 留空 = 手动在 UI 注册
# LANGFUSE_INIT_ORG_NAME=My Org
# LANGFUSE_INIT_PROJECT_NAME=agent-sandbox
# LANGFUSE_INIT_USER_EMAIL=admin@example.com
# LANGFUSE_INIT_USER_PASSWORD=__INIT_USER_PASSWORD__
# LANGFUSE_INIT_USER_NAME=Admin
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-...
# LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-...

# ============================================================
# 7. 可选：Sentry / SMTP 等
# ============================================================
# SENTRY_DSN=
# EMAIL_FROM_ADDRESS=noreply@example.com
# SMTP_CONNECTION_URL=smtps://user:pass@smtp.example.com:465